<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/group_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingRight="18dp"
            android:text="@string/new_group_title"
            android:textColor="@color/gold"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_group_name"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dialog_input"
            android:gravity="center"
            android:hint="@string/group_name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="32"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/text_title"
            android:textColorHint="@color/gray"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_group_save"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_dialog_btn_primary"
            android:gravity="center"
            android:text="@string/save"
            android:textAllCaps="true"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_group_dialog_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_dialog_close"
        android:contentDescription="@string/close_action"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close" />
</FrameLayout>
