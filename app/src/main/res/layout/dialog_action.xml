<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:tag="full">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingRight="86dp"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/label_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_horizontal"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <com.he.he_smartphone_auto_clicker.ui.TimeInputView
            android:id="@+id/input_duration"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:id="@+id/hold_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/label_hold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/swipe_hold_duration"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />

            <com.he.he_smartphone_auto_clicker.ui.TimeInputView
                android:id="@+id/input_hold"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/label_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:text="@string/delay_before_next"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <com.he.he_smartphone_auto_clicker.ui.TimeInputView
            android:id="@+id/input_delay"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/btn_pause_action"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dialog_btn"
            android:gravity="center"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_pause_delay"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_dialog_btn"
            android:gravity="center"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/check_double_click"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:buttonTint="@color/gold"
            android:checked="false"
            android:text="@string/double_click_check"
            android:textColor="@color/gold"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/option_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/label_pinch_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/pinch_mode_label"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_pinch_mode"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_btn"
                android:gravity="center"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/joy_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/label_joy_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/joy_mode_label"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_joy_mode"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_btn"
                android:gravity="center"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/label_joy_radius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:text="@string/joy_radius_label"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/joy_radius_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seek_joy_radius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:max="43"
                android:progress="8"
                android:progressTint="@color/gold"
                android:thumbTint="@color/gold" />

            <TextView
                android:id="@+id/joy_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:text="@string/joy_hint"
                android:textColor="@color/gold_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/block_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/label_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/action_block_label"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_pick_block"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_btn"
                android:gravity="center"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/block_mode_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_horizontal"
                android:textColor="@color/gold_soft"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/index_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btn_index_down"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_dialog_btn"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="@color/gold"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/index_value"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:textColor="@color/text_title"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btn_index_up"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_dialog_btn"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/gold"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_dialog_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_dialog_delete"
            android:contentDescription="@string/delete"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete" />

        <ImageButton
            android:id="@+id/btn_dialog_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_dialog_close"
            android:contentDescription="@string/close_action"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</FrameLayout>
