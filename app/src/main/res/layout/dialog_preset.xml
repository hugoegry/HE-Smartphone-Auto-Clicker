<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:tag="full">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="14dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/preset_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingRight="20dp"
            android:text="@string/preset_panel_title"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_load_preset"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dialog_btn"
            android:gravity="center"
            android:text="@string/load_preset_action"
            android:textAllCaps="false"
            android:textColor="@color/gold"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_ondemand_blocks"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dialog_btn"
            android:gravity="center"
            android:text="@string/ondemand_title"
            android:textAllCaps="false"
            android:textColor="@color/gold_soft"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_gold_separator" />

        <TextView
            android:id="@+id/label_start_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/start_delay_label"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <com.he.he_smartphone_auto_clicker.ui.TimeInputView
            android:id="@+id/input_start_delay"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/label_preset_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/preset_name_title"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_preset_name"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_dialog_input"
            android:gravity="center"
            android:hint="@string/preset_name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="40"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/text_title"
            android:textColorHint="@color/gray"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/preset_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_preset_action"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dialog_btn_primary"
            android:gravity="center"
            android:textAllCaps="true"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btn_preset_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_dialog_close"
        android:contentDescription="@string/close_action"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close" />
</FrameLayout>
